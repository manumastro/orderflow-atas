    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XrayLive</AssemblyName>
    <RootNamespace>XrayLive</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
