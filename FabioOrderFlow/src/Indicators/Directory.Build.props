<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Dove vivono gli assembly di ATAS, che cambia con il sistema E con la versione.
       macOS: dentro il bundle di ATAS X.
       Windows: ATAS X si installa in C:\ATASX; il vecchio ATAS 8 sta in Program Files (x86).
       I due NON sono intercambiabili: ATAS 8 non ha IInstrumentInfo.TimeZoneOffset ne'
       Security.ExpirationMoment, e il suo OFT.Rendering vuole un System.Drawing.Common
       piu' recente di quello che spedisce - la build muore con CS1705 e due CS1061.
       Si prova quindi ATAS X per primo, e si puo' forzare tutto con -p:AtasAssemblyDir=... -->
  <PropertyGroup Condition="'$(AtasAssemblyDir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">
    <AtasAssemblyDir>/Applications/ATAS X.app/Contents/MonoBundle</AtasAssemblyDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AtasAssemblyDir)' == '' and Exists('C:\ATASX\ATAS.Indicators.dll')">
    <AtasAssemblyDir>C:\ATASX</AtasAssemblyDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AtasAssemblyDir)' == ''">
    <AtasAssemblyDir>C:\Program Files (x86)\ATAS Platform</AtasAssemblyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasAssemblyDir)/ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(AtasAssemblyDir)/ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- System.Drawing.Common porta Color, Rectangle e DashStyle, usati dal disegno dei livelli.
         ATAS li espone nella sua API, quindi il riferimento serve anche solo per compilare. -->
    <Reference Include="System.Drawing.Common">
      <HintPath>$(AtasAssemblyDir)/System.Drawing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Serve solo al disegno dei livelli sul chart: RenderContext, RenderPen, RenderFont. -->
    <Reference Include="OFT.Rendering">
      <HintPath>$(AtasAssemblyDir)/OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(AtasAssemblyDir)/Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
