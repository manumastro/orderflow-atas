# Build output
bin/
obj/

# Logs
*.log
*-logs/

# Reproducible local observation archives; their hashes are tracked in reports.
FabioOrderFlow/ledger-snapshots/*.jsonl.gz
FabioOrderFlow/ledger-snapshots/*.csv
FabioOrderFlow/ledger-snapshots/*.json

# Superseded source material kept only in the local workspace
fabio_youtube_live_transcripts/

# IDE
.vs/
.vscode/
*.user

# OS
Thumbs.db
.DS_Store

# Playwright MCP output
.playwright-mcp/

# residui locali, non viaggiano
__pycache__/
.tmp-*

# quant: i dati vengono da ATAS e si riscaricano; build e ambiente locale
quant/dati/
quant/framework/**/bin/
quant/framework/**/obj/
# la pagina XrayWeb: le dipendenze si reinstallano (npm ci), il build si rifa' (npm run build)
quant/strumenti/xray/XrayWeb/node_modules/
quant/strumenti/xray/XrayWeb/dist/
quant/paper/**/*.pdf

# lo studio globale: i JSON grezzi dei collettori restano fuori da git
studio/rapporti/*/dati/
